# ============================================================
# CCCR — Required Vercel Environment Variables
# Copy this file to .env.local for local development.
# Set all variables in the Vercel dashboard for production.
# ============================================================

# ----- AI Provider -----
# Primary OpenAI key — always required (used for RAG embeddings in Fathers mode)
OPENAI_API_KEY=sk-...

# Perplexity Sonar migration (optional A/B switch)
# Set USE_PERPLEXITY=true to route completions to Perplexity instead of OpenAI.
# PERPLEXITY_MODEL defaults to "sonar-pro" if not set.
USE_PERPLEXITY=false
PERPLEXITY_API_KEY=pplx-...
PERPLEXITY_MODEL=sonar-pro

# Override the OpenAI model (default: gpt-4o)
# OPENAI_MODEL=gpt-4o

# ----- Supabase (server-side, used in /api functions) -----
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # Only needed for scripts/generate-embeddings.js

# ----- Email / Zoho -----
ZOHO_EMAIL=support@ccc-study.org
ZOHO_PASSWORD=your-zoho-app-password
